---
import { getLangFromPath, translations } from "../i18n";

const { lang = getLangFromPath(Astro.url.pathname) } = Astro.props;
const t = translations[lang];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-title" set:html={t.footer.title}></p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="7" width="18" height="13" rx="2"></rect>
            <path d="M8 7V5h8v2"></path>
          </svg>
        </span>
        <span set:html={t.footer.availability}></span>
      </p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M9 19c-4-6-2-11 3-11 2 0 4 1 5 3"></path>
            <path d="M12 13h7"></path>
            <path d="M17 9l4 4-4 4"></path>
          </svg>
        </span>
        <a href="https://github.com/Saitelmoum" target="_blank" rel="noreferrer">
          github.com/Saitelmoum
        </a>
      </p>
    </div>
    <div>
      <p class="footer-label" set:html={t.footer.contactLabel}></p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s7-5.2 7-11a7 7 0 0 0-14 0c0 5.8 7 11 7 11z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </span>
        <span set:html={t.footer.address}></span>
      </p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M22 16.5v3a2 2 0 0 1-2.2 2 20 20 0 0 1-8.7-3.1 20 20 0 0 1-6.2-6.2A20 20 0 0 1 1.8 4.2 2 2 0 0 1 3.8 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 2.9a2 2 0 0 1-.5 2.1L7.5 10.5a16 16 0 0 0 6 6l1.8-1.4a2 2 0 0 1 2.1-.5c.9.3 1.9.5 2.9.6a2 2 0 0 1 1.7 1.8z"></path>
          </svg>
        </span>
        <a href="tel:+33749257386">07 49 25 73 86</a>
      </p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
        </span>
        <a href="mailto:salahaitelmoumen@gmail.com">salahaitelmoumen@gmail.com</a>
      </p>
      <p class="footer-note footer-item">
        <span class="footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M8 10v6"></path>
            <path d="M8 8v.01"></path>
            <path d="M12 16v-4a3 3 0 0 1 6 0v4"></path>
          </svg>
        </span>
        <a
          href="https://www.linkedin.com/in/salah-aitelmoumen-105aaa1a3"
          target="_blank"
          rel="noreferrer"
        >
          linkedin.com/in/salah-aitelmoumen-105aaa1a3
        </a>
      </p>
    </div>
  </div>
</footer>
