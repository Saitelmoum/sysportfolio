---
const { icon, title, text } = Astro.props;

const icons = {
  code: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polyline points="16 18 22 12 16 6"></polyline>
      <polyline points="8 6 2 12 8 18"></polyline>
    </svg>
  `,
  layers: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
      <polyline points="2 17 12 22 22 17"></polyline>
      <polyline points="2 12 12 17 22 12"></polyline>
    </svg>
  `,
  workflow: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="6" height="6" rx="1"></rect>
      <rect x="15" y="3" width="6" height="6" rx="1"></rect>
      <rect x="9" y="15" width="6" height="6" rx="1"></rect>
      <path d="M6 9v3a3 3 0 0 0 3 3h6"></path>
      <path d="M18 9v3a3 3 0 0 1-3 3h-1"></path>
    </svg>
  `,
  file: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
    </svg>
  `,
  settings: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 5 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 5 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.44 4.3l.06.06A1.65 1.65 0 0 0 9 4.99 1.65 1.65 0 0 0 10.51 3H11a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 16.51 5a1.65 1.65 0 0 0 1.82-.33l.06-.06A2 2 0 1 1 20.7 7.44l-.06.06A1.65 1.65 0 0 0 19.01 9c0 .66.26 1.3.72 1.77.46.47 1.1.73 1.77.73H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
  `,
  shield: `
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
    </svg>
  `,
};

const svg = icons[icon] ?? "";
---

<div class="icon-bullet">
  <span class="icon-bullet__icon" aria-hidden="true" set:html={svg}></span>
  <div class="icon-bullet__content">
    <span class="icon-bullet__title">{title}</span>
    <span class="icon-bullet__text">{text}</span>
  </div>
</div>
