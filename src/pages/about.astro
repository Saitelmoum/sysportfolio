---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Profil | Consultant SAP Technique">
  <section class="container">
    <h1>Profil</h1>
    <p class="lead">
      Consultant SAP technique confirme, specialiste ABAP et SAP Fiori, avec une approche orientee
      delivery et qualite. Je m'appuie sur les standards SAP pour concevoir des solutions fiables
      et evolutives.
    </p>

    <div class="section">
      <h2>Core Skills</h2>
      <div class="grid">
        <div class="card">
          <h3>ABAP & S/4HANA</h3>
          <p>Developpement ABAP OO, CDS Views, performance, integration S/4HANA.</p>
        </div>
        <div class="card">
          <h3>SAP Fiori</h3>
          <p>Fiori Elements, SAPUI5, services OData, amelioration continue UX.</p>
        </div>
        <div class="card">
          <h3>Architecture</h3>
          <p>Analyse fonctionnelle, cadrage technique, support projet end-to-end.</p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Currently Learning</h2>
      <ul class="list">
        <li>RAP avance et comportement des entites.</li>
        <li>SAP BTP, CAP et strategie d'integration cloud.</li>
        <li>API-led architecture pour scenarios S/4HANA.</li>
      </ul>
    </div>

    <div class="section">
      <h2>Certifications</h2>
      <p class="badge">SAP Fiori Certified</p>
      <p class="note">Preparing SAP S/4HANA Sales certification</p>
    </div>

    <div class="section">
      <h2>CV</h2>
      <div class="actions">
        <a class="button primary" href="/cv/CV_FR.pdf" download="Salah_AITELMOUMEN_CV_FR.pdf">Telecharger CV FR</a>
        <a class="button ghost" href="/cv/CV_EN.pdf" download="Salah_AITELMOUMEN_CV_EN.pdf">Download CV EN</a>
      </div>
    </div>
  </section>
</BaseLayout>
