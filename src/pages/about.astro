---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Profil | Consultant SAP Technique">
  <section class="container">
    <h1>Profile</h1>
    <p class="lead">
      Consultant SAP technique confirm&eacute;, sp&eacute;cialis&eacute; ABAP et SAP Fiori, avec
      une approche orient&eacute;e delivery et qualit&eacute;. Je con&ccedil;ois des solutions SAP
      fiables, &eacute;volutives, et faciles &agrave; maintenir.
    </p>

    <div class="section">
      <h2>Education</h2>
      <div class="card info-row">
        <div class="logo-slot">
          <img
            class="logo-image"
            src="/logos/school.svg"
            alt="Logo de l'ecole"
            onload="this.nextElementSibling.style.display='none';"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';"
          />
          <span class="logo-fallback" aria-hidden="true">School</span>
        </div>
        <div>
          <p class="info-title">Master / Ing&eacute;nierie Informatique</p>
          <p class="info-note">Sp&eacute;cialit&eacute; syst&egrave;mes d'information et ERP.</p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Professional Experience</h2>
      <div class="card info-row">
        <div class="logo-slot">
          <img
            class="logo-image"
            src="/logos/company.svg"
            alt="Logo de l'entreprise"
            onload="this.nextElementSibling.style.display='none';"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';"
          />
          <span class="logo-fallback" aria-hidden="true">Company</span>
        </div>
        <div>
          <p class="info-title">Consultant SAP Technique</p>
          <p class="info-note">
            ABAP OO, RAP, Fiori, S/4HANA &mdash; delivery d'applications m&eacute;tier et services
            OData.
          </p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Technical Skills</h2>
      <div class="skill-bars" role="list">
        <div class="skill-bar" role="listitem">
          <div class="skill-bar__label">
            <span>ABAP (Advanced)</span>
            <span>90%</span>
          </div>
          <div class="skill-bar__track" aria-hidden="true">
            <span class="skill-bar__fill" style="width: 90%;"></span>
          </div>
        </div>
        <div class="skill-bar" role="listitem">
          <div class="skill-bar__label">
            <span>SAP Fiori (Advanced)</span>
            <span>85%</span>
          </div>
          <div class="skill-bar__track" aria-hidden="true">
            <span class="skill-bar__fill" style="width: 85%;"></span>
          </div>
        </div>
        <div class="skill-bar" role="listitem">
          <div class="skill-bar__label">
            <span>RAP (Growing)</span>
            <span>60%</span>
          </div>
          <div class="skill-bar__track" aria-hidden="true">
            <span class="skill-bar__fill" style="width: 60%;"></span>
          </div>
        </div>
        <div class="skill-bar" role="listitem">
          <div class="skill-bar__label">
            <span>SAP BTP (Growing)</span>
            <span>45%</span>
          </div>
          <div class="skill-bar__track" aria-hidden="true">
            <span class="skill-bar__fill" style="width: 45%;"></span>
          </div>
        </div>
        <div class="skill-bar" role="listitem">
          <div class="skill-bar__label">
            <span>CAP (Growing)</span>
            <span>35%</span>
          </div>
          <div class="skill-bar__track" aria-hidden="true">
            <span class="skill-bar__fill" style="width: 35%;"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Soft Skills</h2>
      <ul class="list">
        <li>Communication claire avec les &eacute;quipes m&eacute;tier et IT.</li>
        <li>Rigueur, autonomie, sens du service et qualit&eacute;.</li>
        <li>Capacit&eacute; &agrave; cadrer et prioriser.</li>
      </ul>
    </div>

    <div class="section">
      <h2>Languages</h2>
      <ul class="list">
        <li>Fran&ccedil;ais &mdash; natif.</li>
        <li>Anglais &mdash; professionnel.</li>
      </ul>
    </div>

    <div class="section" id="certifications">
      <h2><Icon name="award" /> Certifications</h2>
      <div class="badge-list">
        <span class="badge">SAP Fiori Certified</span>
        <span class="badge">SAP S/4HANA Sales Certified</span>
      </div>
      <p class="note">ABAP Cloud Developer (in progress)</p>
    </div>

    <div class="section">
      <h2>Academic / Personal Projects</h2>
      <ul class="list">
        <li>RAP case study: services, OData V4, et Fiori elements.</li>
        <li>QM automation workflow pour contr&ocirc;les qualit&eacute;.</li>
        <li>CAP mini-app pour collecte de donn&eacute;es m&eacute;tier.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
