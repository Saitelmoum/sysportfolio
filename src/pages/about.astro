---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="&Agrave; propos | Consultant SAP Technique">
  <section class="container about-page">
    <header class="about-hero">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 2l9 4-9 4-9-4 9-4z"></path>
            <path d="M3 10l9 4 9-4"></path>
            <path d="M3 14l9 4 9-4"></path>
          </svg>
        </span>
        <div>
          <h1>&Agrave; propos</h1>
          <p class="subtitle">
            Salah AITELMOUMEN &mdash; Consultant SAP Technique (ABAP &bull; Fiori &bull; RAP)
          </p>
        </div>
      </div>
      <p class="lead">
        Bient&ocirc;t 3 ans d&rsquo;exp&eacute;rience en delivery SAP, sp&eacute;cialis&eacute; ABAP, SAPUI5 et Fiori, certifi&eacute; SAP
        Fiori et SAP S/4HANA Sales. Mont&eacute;e en comp&eacute;tences sur RAP, SAP BTP et le cloud, avec une
        approche technico-fonctionnelle orient&eacute;e SD (Order-to-Cash).
      </p>
    </header>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v6l3 3"></path>
          </svg>
        </span>
        <h2>Mon parcours</h2>
      </div>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">Oct. 2023 &ndash; Aujourd&rsquo;hui</span>
              <span class="timeline-role">SOPRA STERIA GROUP (Toulouse) &mdash; Consultant SAP</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-chip">ABAP</div>
              <div class="timeline-chip">SAPUI5 / Fiori</div>
              <div class="timeline-chip">SAP Gateway OData/REST</div>
              <div class="timeline-chip">Tests unitaires + end-to-end</div>
              <div class="timeline-chip">Agile / Scrum, JIRA</div>
              <div class="timeline-chip">Veille SAP BTP, IA g&eacute;n&eacute;rative, cloud</div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">Mar. 2023 &ndash; Sep. 2023</span>
              <span class="timeline-role">SOPRA STERIA (Toulouse) &mdash; Stagiaire Consultant SAP</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-chip">ABAP (ALV, FM, BAPI)</div>
              <div class="timeline-chip">Performance / clean code</div>
              <div class="timeline-chip">SmartForms</div>
              <div class="timeline-chip">Support TMA / tickets / incidents</div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">2020 &ndash; 2023</span>
              <span class="timeline-role">
                SIGMA Clermont (Aubi&egrave;re) &mdash; Dipl&ocirc;me d&rsquo;ing&eacute;nieur (G&eacute;nie industriel &amp; proc&eacute;d&eacute;s)
              </span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">2018 &ndash; 2020</span>
              <span class="timeline-role">Classes pr&eacute;paratoires TSI &mdash; Ibn Baja Med School</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M7 8h10M7 12h10M7 16h6"></path>
          </svg>
        </span>
        <h2>Comp&eacute;tences</h2>
      </div>
      <div class="skills-table card">
        <div class="skills-row skills-header">
          <span>Domaine</span>
          <span>Technologies</span>
          <span>Niveau</span>
          <span>Preuves</span>
        </div>
        <div class="skills-row">
          <span>ABAP</span>
          <span>ALV, ABAP OO, BAPI, enhancements/user exits, SmartForms</span>
          <span class="badge">Avanc&eacute;</span>
          <span>Projets ABAP en production</span>
        </div>
        <div class="skills-row">
          <span>SAPUI5 / Fiori</span>
          <span>Apps Fiori, UI5 freestyle</span>
          <span class="badge">Confirm&eacute;</span>
          <span>Apps Fiori</span>
        </div>
        <div class="skills-row">
          <span>SAP Gateway</span>
          <span>OData, REST</span>
          <span class="badge">Confirm&eacute;</span>
          <span>OData services</span>
        </div>
        <div class="skills-row">
          <span>RAP</span>
          <span>ADT, CDS, Behavior definition, Service binding</span>
          <span class="badge">Mont&eacute;e en comp&eacute;tences</span>
          <span>Portfolio RAP</span>
        </div>
        <div class="skills-row">
          <span>SAP BTP</span>
          <span>Services cloud SAP</span>
          <span class="badge">Mont&eacute;e en comp&eacute;tences</span>
          <span>Formations internes</span>
        </div>
        <div class="skills-row">
          <span>Python</span>
          <span>Scripting / data tools</span>
          <span class="badge">Interm&eacute;diaire</span>
          <span>Automatisation</span>
        </div>
        <div class="skills-row">
          <span>Outils</span>
          <span>Postman, JIRA, Office, Excel, PowerPoint</span>
          <span class="badge">Confirm&eacute;</span>
          <span>Delivery projet</span>
        </div>
        <div class="skills-row">
          <span>Performance &amp; transversal</span>
          <span>ST05, SAT, STMS, SU53</span>
          <span class="badge">Interm&eacute;diaire</span>
          <span>Bonne base / pratique projet</span>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 7h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 17h16"></path>
          </svg>
        </span>
        <h2>Certifications &amp; Formations</h2>
      </div>
      <div class="two-col">
        <div class="stack">
          <article class="card cert-card">
            <div class="cert-title">SAP Fiori Certified</div>
            <span class="badge">Certifi&eacute;</span>
            <p class="muted">
              Certification SAP Fiori pour la conception et l&rsquo;impl&eacute;mentation d&rsquo;interfaces.
            </p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">SAP S/4HANA Sales Certified</div>
            <span class="badge">Certifi&eacute;</span>
            <p class="muted">Certification SAP S/4HANA Sales pour les processus commerciaux.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">Six Sigma Yellow Belt</div>
            <span class="badge">Certifi&eacute;</span>
            <p class="muted">Culture qualit&eacute; et am&eacute;lioration continue.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">ABAP Cloud Developer</div>
            <span class="badge">En pr&eacute;paration</span>
            <p class="muted">Parcours de pr&eacute;paration sur ABAP cloud et RAP.</p>
          </article>
        </div>
        <div class="stack">
          <article class="card cert-card">
            <div class="cert-title">SAP BTP Cloud Overview</div>
            <span class="badge">Formation interne</span>
            <p class="muted">Introduction aux services cloud SAP BTP.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">SAP Gateway &amp; SAPUI5</div>
            <span class="badge">Formation interne</span>
            <p class="muted">Services OData, UI5 et bonnes pratiques Fiori.</p>
          </article>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3l9 4-9 4-9-4 9-4z"></path>
            <path d="M3 11l9 4 9-4"></path>
            <path d="M7 19h10"></path>
          </svg>
        </span>
        <h2>Langues &amp; soft skills</h2>
      </div>
      <div class="grid two-col">
        <div class="card">
          <div class="card-title">Langues</div>
          <div class="chip-grid">
            <span class="chip">Fran&ccedil;ais &mdash; courant</span>
            <span class="chip">Anglais &mdash; professionnel</span>
            <span class="chip">Allemand &mdash; d&eacute;butant</span>
          </div>
        </div>
        <div class="card">
          <div class="card-title">Soft skills</div>
          <div class="chip-grid">
            <span class="chip">Esprit d&rsquo;&eacute;quipe</span>
            <span class="chip">Autonomie</span>
            <span class="chip">Rigueur / organisation</span>
            <span class="chip">R&eacute;solution de probl&egrave;mes</span>
            <span class="chip">Technico-fonctionnel</span>
            <span class="chip">Agile / Scrum</span>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8 12h8"></path>
            <path d="M12 8v8"></path>
          </svg>
        </span>
        <h2>Centres d&rsquo;int&eacute;r&ecirc;t</h2>
      </div>
      <div class="chip-row">
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M12 6v12"></path>
            <path d="M6 12h12"></path>
          </svg>
          Apprentissage des langues
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M4 4h12v16H4z"></path>
            <path d="M16 8h4v12H8"></path>
          </svg>
          Lecture
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v10"></path>
            <path d="M8 12h8"></path>
          </svg>
          Histoire
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M3 18c4-6 14-6 18 0"></path>
            <path d="M12 6c-2 2-3 4-3 6"></path>
          </svg>
          Nature
        </span>
      </div>
    </section>

    <section class="section">
      <div class="card cta-card">
        <div>
          <h2>&Eacute;changeons</h2>
          <p class="muted">
            Discutons de vos besoins SAP ou d&rsquo;une opportunit&eacute;. Je reviens vers vous rapidement.
          </p>
        </div>
        <a class="button primary" href="/contact">Me contacter</a>
      </div>
    </section>
  </section>
</BaseLayout>
