---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Profil | Consultant SAP Technique">
  <section class="container">
    <h1>Profil</h1>
    <p class="lead">
      Consultant SAP technique confirme, specialiste ABAP et SAP Fiori, avec une approche orientee
      delivery et qualite. Je m'appuie sur les standards SAP pour concevoir des solutions fiables
      et evolutives.
    </p>

    <div class="section">
      <h2>Core Skills</h2>
      <div class="grid">
        <div class="card">
          <h3>ABAP &amp; S/4HANA</h3>
          <p>Developpement ABAP OO, CDS Views, performance, integration S/4HANA.</p>
        </div>
        <div class="card">
          <h3>SAP Fiori</h3>
          <p>Fiori Elements, SAPUI5, services OData, amelioration continue UX.</p>
        </div>
        <div class="card">
          <h3>Architecture</h3>
          <p>Analyse fonctionnelle, cadrage technique, support projet end-to-end.</p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Currently Preparing</h2>
      <ul class="list">
        <li>ABAP Cloud Developer (in progress).</li>
      </ul>
    </div>

    <div class="section" id="certifications">
      <h2><Icon name="award" /> Certifications</h2>
      <div class="badge-list">
        <span class="badge">SAP Fiori Certified</span>
        <span class="badge">SAP S/4HANA Sales Certified</span>
      </div>
    </div>

    <div class="section">
      <h2>CV</h2>
      <div class="actions">
        <a class="button primary" href="/cv/CV_FR.pdf" download="Salah_AITELMOUMEN_CV_FR.pdf">
          Telecharger CV FR
        </a>
        <a href="/cv/CV_FR.pdf" target="_blank" rel="noopener">Voir en ligne</a>
        <a class="button ghost" href="/cv/CV_EN.pdf" download="Salah_AITELMOUMEN_CV_EN.pdf">
          Download CV EN
        </a>
        <a href="/cv/CV_EN.pdf" target="_blank" rel="noopener">View online</a>
      </div>
    </div>
  </section>
</BaseLayout>
