---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Contact | Consultant SAP Technique">
  <section class="container">
    <h1>Contact</h1>
    <p class="lead">Disponible pour &eacute;changer sur vos besoins SAP.</p>
    <div class="section">
      <div class="card">
        <p>
          <strong><Icon name="mail" /> Email</strong>:
          <a href="mailto:salahaitelmoumen@gmail.com">salahaitelmoumen@gmail.com</a>
        </p>
        <p>
          <strong><Icon name="linkedin" /> LinkedIn</strong>:
          <a href="https://www.linkedin.com/in/salah-aitelmoumen-105aaa1a3" target="_blank" rel="noreferrer">
            linkedin.com/in/salah-aitelmoumen-105aaa1a3
          </a>
        </p>
      </div>
    </div>

    <div class="section">
      <div class="card">
        <h2>Formulaire de contact</h2>
        <form
          class="contact-form"
          method="POST"
          action="https://formspree.io/f/mwvpgkdl"
        >
          <div class="form-field">
            <label for="contact-name">Nom</label>
            <input id="contact-name" name="name" type="text" required />
          </div>
          <div class="form-field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required />
          </div>
          <div class="form-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>
          <button class="button primary" type="submit">Envoyer le message</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.querySelector(".contact-form");
  if (form) {
    const status = form.querySelector(".form-status");
    const submitButton = form.querySelector("button[type='submit']");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitButton || !status) {
        form.submit();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Envoi...";
      status.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          form.reset();
          status.textContent =
            "Merci ! Votre message a bien &eacute;t&eacute; envoy&eacute;. Je vous r&eacute;pondrai d&egrave;s que possible. Bonne journ&eacute;e ??";
        } else {
          status.textContent =
            "Oups? impossible d&rsquo;envoyer le message pour le moment. Vous pouvez me contacter directement &agrave; salahaitelmoumen@gmail.com";
        }
      } catch (error) {
        status.textContent =
          "Oups? impossible d&rsquo;envoyer le message pour le moment. Vous pouvez me contacter directement &agrave; salahaitelmoumen@gmail.com";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Envoyer le message";
      }
    });
  }
</script>
