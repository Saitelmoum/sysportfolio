---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" title="About | SAP Technical Consultant">
  <section class="container about-page">
    <header class="about-hero">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 2l9 4-9 4-9-4 9-4z"></path>
            <path d="M3 10l9 4 9-4"></path>
            <path d="M3 14l9 4 9-4"></path>
          </svg>
        </span>
        <div>
          <h1>About</h1>
          <p class="subtitle">
            Salah AITELMOUMEN — SAP Technical Consultant (ABAP • Fiori • RAP)
          </p>
        </div>
      </div>
      <p class="lead">
        Nearly 3 years of SAP delivery experience, specialized in ABAP, SAPUI5, and Fiori, certified
        SAP Fiori and SAP S/4HANA Sales. Growing expertise in RAP, SAP BTP, and cloud, with a
        techno-functional focus on SD (Order-to-Cash).
      </p>
    </header>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v6l3 3"></path>
          </svg>
        </span>
        <h2>Career</h2>
      </div>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">Oct 2023 – Present</span>
              <span class="timeline-role">SOPRA STERIA GROUP (Toulouse) — SAP Consultant</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-chip">ABAP</div>
              <div class="timeline-chip">SAPUI5 / Fiori</div>
              <div class="timeline-chip">SAP Gateway OData/REST</div>
              <div class="timeline-chip">Unit + end-to-end testing</div>
              <div class="timeline-chip">Agile / Scrum, JIRA</div>
              <div class="timeline-chip">SAP BTP, generative AI, cloud watch</div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">Mar 2023 – Sep 2023</span>
              <span class="timeline-role">SOPRA STERIA (Toulouse) — SAP Consultant Intern</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-chip">ABAP (ALV, FM, BAPI)</div>
              <div class="timeline-chip">Performance / clean code</div>
              <div class="timeline-chip">SmartForms</div>
              <div class="timeline-chip">TMA support / tickets / incidents</div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">2020 – 2023</span>
              <span class="timeline-role">
                SIGMA Clermont (Aubiere) — Engineering Degree (Industrial Engineering &amp; Processes)
              </span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-date">2018 – 2020</span>
              <span class="timeline-role">TSI preparatory classes — Ibn Baja Med School</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M7 8h10M7 12h10M7 16h6"></path>
          </svg>
        </span>
        <h2>Skills</h2>
      </div>
      <div class="skills-table card">
        <div class="skills-row skills-header">
          <span>Domain</span>
          <span>Technologies</span>
          <span>Level</span>
          <span>Evidence</span>
        </div>
        <div class="skills-row">
          <span>ABAP</span>
          <span>ALV, ABAP OO, BAPI, enhancements/user exits, SmartForms</span>
          <span class="badge">Advanced</span>
          <span>Production ABAP projects</span>
        </div>
        <div class="skills-row">
          <span>SAPUI5 / Fiori</span>
          <span>Fiori apps, UI5 freestyle</span>
          <span class="badge">Confirmed</span>
          <span>Fiori apps</span>
        </div>
        <div class="skills-row">
          <span>SAP Gateway</span>
          <span>OData, REST</span>
          <span class="badge">Confirmed</span>
          <span>OData services</span>
        </div>
        <div class="skills-row">
          <span>RAP</span>
          <span>ADT, CDS, Behavior definition, Service binding</span>
          <span class="badge">Growing</span>
          <span>RAP portfolio</span>
        </div>
        <div class="skills-row">
          <span>SAP BTP</span>
          <span>SAP cloud services</span>
          <span class="badge">Growing</span>
          <span>Internal trainings</span>
        </div>
        <div class="skills-row">
          <span>Python</span>
          <span>Scripting / data tools</span>
          <span class="badge">Intermediate</span>
          <span>Automation</span>
        </div>
        <div class="skills-row">
          <span>Tools</span>
          <span>Postman, JIRA, Office, Excel, PowerPoint</span>
          <span class="badge">Confirmed</span>
          <span>Project delivery</span>
        </div>
        <div class="skills-row">
          <span>Performance &amp; cross topics</span>
          <span>ST05, SAT, STMS, SU53</span>
          <span class="badge">Intermediate</span>
          <span>Good foundation / project practice</span>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 7h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 17h16"></path>
          </svg>
        </span>
        <h2>Certifications &amp; Training</h2>
      </div>
      <div class="two-col">
        <div class="stack">
          <article class="card cert-card">
            <div class="cert-title">SAP Fiori Certified</div>
            <span class="badge">Certified</span>
            <p class="muted">
              SAP Fiori certification for UI design and implementation.
            </p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">SAP S/4HANA Sales Certified</div>
            <span class="badge">Certified</span>
            <p class="muted">SAP S/4HANA Sales certification for commercial processes.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">Six Sigma Yellow Belt</div>
            <span class="badge">Certified</span>
            <p class="muted">Quality culture and continuous improvement.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">ABAP Cloud Developer</div>
            <span class="badge">In progress</span>
            <p class="muted">Preparation track on ABAP Cloud and RAP.</p>
          </article>
        </div>
        <div class="stack">
          <article class="card cert-card">
            <div class="cert-title">SAP BTP Cloud Overview</div>
            <span class="badge">Internal training</span>
            <p class="muted">Introduction to SAP BTP cloud services.</p>
          </article>
          <article class="card cert-card">
            <div class="cert-title">SAP Gateway &amp; SAPUI5</div>
            <span class="badge">Internal training</span>
            <p class="muted">OData services, UI5, and Fiori best practices.</p>
          </article>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3l9 4-9 4-9-4 9-4z"></path>
            <path d="M3 11l9 4 9-4"></path>
            <path d="M7 19h10"></path>
          </svg>
        </span>
        <h2>Languages &amp; soft skills</h2>
      </div>
      <div class="grid two-col">
        <div class="card">
          <div class="card-title">Languages</div>
          <div class="chip-grid">
            <span class="chip">French — fluent</span>
            <span class="chip">English — professional</span>
            <span class="chip">German — beginner</span>
          </div>
        </div>
        <div class="card">
          <div class="card-title">Soft skills</div>
          <div class="chip-grid">
            <span class="chip">Team spirit</span>
            <span class="chip">Autonomy</span>
            <span class="chip">Rigor / organization</span>
            <span class="chip">Problem solving</span>
            <span class="chip">Techno-functional</span>
            <span class="chip">Agile / Scrum</span>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="section-title">
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8 12h8"></path>
            <path d="M12 8v8"></path>
          </svg>
        </span>
        <h2>Interests</h2>
      </div>
      <div class="chip-row">
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M12 6v12"></path>
            <path d="M6 12h12"></path>
          </svg>
          Language learning
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M4 4h12v16H4z"></path>
            <path d="M16 8h4v12H8"></path>
          </svg>
          Reading
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v10"></path>
            <path d="M8 12h8"></path>
          </svg>
          History
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24" class="chip-icon" aria-hidden="true">
            <path d="M3 18c4-6 14-6 18 0"></path>
            <path d="M12 6c-2 2-3 4-3 6"></path>
          </svg>
          Nature
        </span>
      </div>
    </section>

    <section class="section">
      <div class="card cta-card">
        <div>
          <h2>Let us connect</h2>
          <p class="muted">
            Let us discuss your SAP needs or an opportunity. I will get back to you quickly.
          </p>
        </div>
        <a class="button primary" href="/en/contact">Contact me</a>
      </div>
    </section>
  </section>
</BaseLayout>
