---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
---

<BaseLayout lang="en" title="Contact | SAP Technical Consultant">
  <section class="container">
    <h1>Contact</h1>
    <p class="lead">Available to discuss your SAP needs.</p>
    <div class="section">
      <div class="card">
        <p>
          <strong><Icon name="mail" /> Email</strong>:
          <a href="mailto:salahaitelmoumen@gmail.com">salahaitelmoumen@gmail.com</a>
        </p>
        <p>
          <strong><Icon name="linkedin" /> LinkedIn</strong>:
          <a href="https://www.linkedin.com/in/salah-aitelmoumen-105aaa1a3" target="_blank" rel="noreferrer">
            linkedin.com/in/salah-aitelmoumen-105aaa1a3
          </a>
        </p>
      </div>
    </div>

    <div class="section">
      <div class="card">
        <h2>Contact form</h2>
        <form
          class="contact-form"
          method="POST"
          action="https://formspree.io/f/mwvpgkdl"
        >
          <div class="form-field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" required />
          </div>
          <div class="form-field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required />
          </div>
          <div class="form-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>
          <button class="button primary" type="submit">Send message</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.querySelector(".contact-form");
  if (form) {
    const status = form.querySelector(".form-status");
    const submitButton = form.querySelector("button[type='submit']");
    const decodeEntities = (value) => {
      const doc = new DOMParser().parseFromString(value, "text/html");
      return doc.documentElement.textContent;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitButton || !status) {
        form.submit();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
      status.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          form.reset();
          status.textContent = decodeEntities(
            "Thanks! Your message has been sent. I will reply as soon as possible. Have a great day!"
          );
        } else {
          status.textContent = decodeEntities(
            "Oops... Unable to send the message right now. You can contact me directly at salahaitelmoumen@gmail.com"
          );
        }
      } catch (error) {
        status.textContent = decodeEntities(
          "Oops... Unable to send the message right now. You can contact me directly at salahaitelmoumen@gmail.com"
        );
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Send message";
      }
    });
  }
</script>
