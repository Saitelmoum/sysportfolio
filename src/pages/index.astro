---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import IconBullet from "../components/IconBullet.astro";
---

<BaseLayout>
  <section class="welcome-section">
    <div class="container welcome-grid">
      <div class="welcome-text">
        <h1>Du code ABAP aux architectures SAP modernes</h1>
        <p class="lead">
          Je suis consultant SAP technique depuis bient&ocirc;t trois ans. J&rsquo;ai commenc&eacute; mon
          parcours avec l&rsquo;ABAP classique, en travaillant sur des besoins concrets et des
          probl&eacute;matiques de production.
        </p>
        <p class="lead">
          Avec l&rsquo;exp&eacute;rience, j&rsquo;ai &eacute;largi mon p&eacute;rim&egrave;tre vers SAP Fiori et
          SAPUI5, sur lesquels je suis certifi&eacute;. En parall&egrave;le, j&rsquo;ai d&eacute;velopp&eacute;
          une compr&eacute;hension globale des flux m&eacute;tiers SAP, avec une sp&eacute;cialisation plus
          marqu&eacute;e sur le module SD, &eacute;galement certifi&eacute;e.
        </p>
        <p class="lead">
          Aujourd&rsquo;hui, je poursuis cette &eacute;volution dans une logique de mont&eacute;e en
          comp&eacute;tence continue, en me concentrant sur SAP RAP, SAP BTP et les outils de
          d&eacute;veloppement SAP modernes, avec une approche orient&eacute;e qualit&eacute; et bonnes
          pratiques projet.
        </p>
        <p class="lead">
          Ce site est mon portfolio. N&rsquo;h&eacute;sitez pas &agrave; me contacter pour une
          opportunit&eacute;, ou simplement pour &eacute;changer.
        </p>
      </div>
      <div class="welcome-divider" aria-hidden="true"></div>
      <div class="welcome-photo">
        <img
          src="/profile/salah.jpg"
          alt="Salah AITELMOUMEN - SAP Technical Consultant"
          class="profile-photo"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="card hero-card">
      <h2>Expertise terrain</h2>
      <ul class="expertise-list">
        <li>
          <IconBullet
            icon="code"
            title="D&eacute;veloppement ABAP OO"
            text=" : programmes Z, ALV, SmartForms, IDocs, BAPIs, BADIs, User-Exits et enhancements."
          />
        </li>
        <li>
          <IconBullet
            icon="layers"
            title="SAP Fiori / UI5"
            text=" : applications Fiori, UI5 freestyle, CDS Views, SAP Gateway, OData V2 &amp; V4, tests via Postman."
          />
        </li>
        <li>
          <IconBullet
            icon="workflow"
            title="ABAP RAP (en mont&eacute;e en puissance)"
            text=" : ADT, CDS entities, Behavior Definitions (BDEF), Service Binding, OData V4."
          />
        </li>
        <li>
          <IconBullet
            icon="file"
            title="Documentation technique"
            text=" : analyses techniques, sp&eacute;cifications, tests unitaires, documentation end-to-end des solutions."
          />
        </li>
        <li>
          <IconBullet
            icon="settings"
            title="Analyse fonctionnelle SD &amp; param&eacute;trage SPRO"
            text=" : compr&eacute;hension des flux m&eacute;tiers et int&eacute;gration technico-fonctionnelle."
          />
        </li>
        <li>
          <IconBullet
            icon="shield"
            title="Sujets transverses &amp; performance"
            text=" : transports (STMS), autorisations (SU53), analyse de performance (ST05, SAT)."
          />
        </li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>Featured Projects</h2>
    <div class="grid">
      <article class="card featured">
        <h3>Coffee Subscription (RAP) [Featured]</h3>
        <p>End-to-end RAP service for subscription management and recurring orders.</p>
        <div class="tag-row">
          <span class="tag-label"><Icon name="tag" />Tags</span>
          <span class="tag">RAP Managed</span>
          <span class="tag">Draft</span>
          <span class="tag">OData V4</span>
          <span class="tag">Fiori elements</span>
        </div>
        <p class="note"><a href="/projects/coffee-subscription">Open case study</a></p>
      </article>

      <article class="card">
        <h3>SAP QM Stock Automation [WIP]</h3>
        <p>Automation for SAP QM inspections, stock checks, and notification flows.</p>
        <div class="tag-row">
          <span class="tag-label"><Icon name="tag" />Tags</span>
          <span class="tag">QM</span>
          <span class="tag">ABAP</span>
          <span class="tag">Workflow</span>
        </div>
        <span class="status wip">WIP</span>
      </article>

      <article class="card">
        <h3>BTP/CAP Mini App [Planned]</h3>
        <p>Planned CAP micro-app for data capture and service exposure on BTP.</p>
        <div class="tag-row">
          <span class="tag-label"><Icon name="tag" />Tags</span>
          <span class="tag">BTP</span>
          <span class="tag">CAP</span>
          <span class="tag">API</span>
        </div>
        <span class="status planned">Planned</span>
      </article>
    </div>
  </section>
</BaseLayout>
