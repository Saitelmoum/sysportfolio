---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero container">
    <div>
      <p class="eyebrow">SAP Technical Consultant</p>
      <span class="badge">SAP Fiori Certified</span>
      <h1>
        Consultant SAP Technique &mdash; ABAP (confirm&eacute;) | SAP Fiori (certifi&eacute;) | En
        progression sur RAP, BTP &amp; CAP
      </h1>
      <p class="lead">
        J'accompagne les equipes SAP sur des parcours S/4HANA fiables, des interfaces Fiori claires
        et des services ABAP robustes.
      </p>
      <p class="note">Preparing SAP S/4HANA Sales certification</p>
      <div class="actions">
        <a class="button primary" href="/projects/coffee-subscription">Voir l'etude de cas</a>
        <a class="button ghost" href="/about">Profil &amp; competences</a>
      </div>
    </div>
    <div class="card hero-card">
      <h2>Focus MVP</h2>
      <ul class="checklist">
        <li>Conception de services RAP et CDS pour apps metier.</li>
        <li>Integration Fiori UX, OData V4 et bonnes pratiques UX.</li>
        <li>Automatisation SAP QM et flux d'approvisionnement.</li>
        <li>Exploration BTP, CAP et architectures cloud SAP.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
