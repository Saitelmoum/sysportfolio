---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projets | Consultant SAP Technique">
  <section class="container">
    <h1>Projets</h1>
    <p class="lead">Selection de cas d'usage SAP et prototypes recents.</p>

    <div class="section grid">
      <article class="card">
        <h2>Coffee Subscription (RAP)</h2>
        <p>Service RAP complet pour la gestion d'abonnements et commandes recurrentes.</p>
        <div>
          <span class="tag">RAP</span>
          <span class="tag">OData V4</span>
          <span class="tag">Fiori</span>
        </div>
        <p class="note"><a href="/projects/coffee-subscription">Voir le case study</a></p>
      </article>

      <article class="card">
        <h2>QM Stock Automation</h2>
        <p>Automatisation des controles stock et notifications qualite SAP QM.</p>
        <div>
          <span class="tag">QM</span>
          <span class="tag">ABAP</span>
        </div>
        <span class="status wip">WIP</span>
      </article>

      <article class="card">
        <h2>BTP/CAP Mini App</h2>
        <p>Micro-application CAP pour collecter et exposer des donnees metier.</p>
        <div>
          <span class="tag">BTP</span>
          <span class="tag">CAP</span>
        </div>
        <span class="status planned">Planned</span>
      </article>
    </div>
  </section>
</BaseLayout>
